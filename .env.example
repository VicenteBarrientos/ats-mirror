# ATS Mirror — local configuration
# Copy to .env and fill in values. Never commit .env.

# ATS provider: mock | workable
ATS_PROVIDER=mock

# When true, ATS write operations are logged, not sent.
# Local SQLite mirroring is not an ATS write.
DRY_RUN=true

# SQLite is the local default. Use an absolute path if you start the API
# from a directory other than backend/.
DATABASE_URL=sqlite:///./recruiting_ops.db

LOG_LEVEL=INFO

# Workable Recruiter API (SPI v3). Account token, scopes r_jobs and r_candidates.
# Leave empty for mock. Never expose these values to the frontend.
WORKABLE_SUBDOMAIN=
WORKABLE_ACCESS_TOKEN=

# Binary resume archival is disabled. File metadata only.
DOWNLOAD_ATTACHMENTS=false

# ATS Mirror does not use an LLM.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HTTP client defaults for ATS adapters
ATS_REQUEST_TIMEOUT_SECONDS=30
ATS_MAX_RETRIES=3

# Subtracted from per-connection watermarks before updated_after.
# Official timestamps are often second-granularity; overlap prefers duplicates.
INCREMENTAL_OVERLAP_SECONDS=120
